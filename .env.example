# Copy to .env (make does this for you on first run). Local placeholders only; never commit real secrets.

# Shared secret between Undo and Shopfront for the /v1 API.
SHOP_API_KEY=shop_local_api_key_change_me
# Token for Shopfront /admin endpoints (demo and scripted model only).
SHOP_ADMIN_TOKEN=shop_local_admin_token_change_me
# HMAC secret for Shopfront webhooks.
SHOP_WEBHOOK_SECRET=whsec_local_change_me_0123456789
# HS256 secret for console sessions. At least 32 bytes.
UNDO_JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef
# Enables /demo, /api/demo/** and the demo users.
UNDO_DEMO=false
# Demo only: a fixed key for the demo-support agent (undo_sk_ + 43 letters/digits). Empty = a new
# key is generated and printed once in the undo-api log.
UNDO_DEMO_AGENT_KEY=
# scripted (no network) or claude (needs ANTHROPIC_API_KEY).
UNDO_AGENT_MODE=scripted
# Needed only for claude mode and advisory notes. Leave empty otherwise.
ANTHROPIC_API_KEY=
# Creates the first admin if no users exist (optional outside demo mode).
UNDO_BOOTSTRAP_ADMIN_EMAIL=
UNDO_BOOTSTRAP_ADMIN_PASSWORD=
# Shopfront timing. Demo uses a 1 minute export lag.
SHOP_SETTLEMENT_DELAY=PT10M
SHOP_EXPORT_LAG=PT15M
SHOP_IDEMPOTENCY_TTL=PT24H
# Chaos profile only: probability that a worker halts at each crash point hit.
UNDO_CHAOS_HALT_PROBABILITY=0.0
