<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.undo</groupId><artifactId>undo-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>undo-sim</artifactId>
  <name>undo-sim</name>
  <description>Deterministic simulator: runs the real engine against a seeded world with faults.</description>

  <dependencies>
    <dependency><groupId>dev.undo</groupId><artifactId>undo-core</artifactId></dependency>
    <dependency><groupId>dev.undo</groupId><artifactId>connector-shopfront</artifactId></dependency>
    <dependency><groupId>dev.undo</groupId><artifactId>shopfront-core</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>dev.undo</groupId><artifactId>undo-core</artifactId><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>net.jqwik</groupId><artifactId>jqwik</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- regression seeds live with the tests (Section 21.7) and ship in the jar for make sim -->
      <resource><directory>src/test/resources</directory><includes><include>regression-seeds.txt</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>undo-sim</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.undo.sim.SimMain</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude></excludes></filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
